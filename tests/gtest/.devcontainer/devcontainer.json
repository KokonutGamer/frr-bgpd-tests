{
    "name": "FRR bgpd Google Test Environment",
    "dockerComposeFile": "compose.yml",
    "service": "gtest-dev",
    "workspaceFolder": "/gtest",
    "shutdownAction": "stopCompose",
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/home/frr/.local/bin"
    },
    "remoteUser": "frr",
    "updateRemoteUserUID": true,
    "features": {
        "ghcr.io/devcontainers-extra/features/cmake:1": {
            "version": "latest"
        }
    },
    "postCreateCommand": "sudo bash .devcontainer/setup.sh"
}